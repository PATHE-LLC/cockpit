    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "The shared field, with larger text below the medium breakpoint.",
      "html": "<label class=\"ds-field-label\" for=\"ds-name\">Name</label><input class=\"ds-field\" id=\"ds-name\" type=\"text\" placeholder=\"Your name\">",
      "css": ".ds-field-label{display:block;margin-bottom:8px;color:var(--foreground);font-size:14px;font-weight:500;font-family:var(--font-geist-sans,Geist),Arial,sans-serif;}.ds-field{height:36px;width:100%;min-width:0;padding:4px 12px;border:1px solid var(--input);border-radius:var(--radius-4xl,1.625rem);background:color-mix(in oklch,var(--input) 30%,transparent);color:var(--foreground);font-size:16px;line-height:24px;transition:color 150ms,border-color 150ms,box-shadow 150ms;font-family:var(--font-geist-sans,Geist),Arial,sans-serif;}.ds-field::placeholder{color:var(--muted-foreground);}.ds-field:focus-visible{border-color:var(--ring);outline:none;box-shadow:0 0 0 3px color-mix(in oklch,var(--ring) 50%,transparent);}.ds-field:disabled{pointer-events:none;cursor:not-allowed;opacity:.5;}.ds-field[aria-invalid=true]{border-color:var(--destructive);box-shadow:0 0 0 3px color-mix(in oklch,var(--destructive) 20%,transparent);}@media(min-width:768px){.ds-field{font-size:14px;line-height:20px;}}"
    },
    {
