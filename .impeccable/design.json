      "description": "Existing base-maia primary variant; default size.",
      "html": "<button type=\"button\" class=\"ds-button-primary\">Run checks</button>",
      "css": ".ds-button-primary{display:inline-flex;align-items:center;justify-content:center;gap:6px;height:36px;padding:0 12px;border:1px solid transparent;border-radius:var(--radius-4xl,1.625rem);font-size:14px;font-weight:500;line-height:20px;white-space:nowrap;cursor:pointer;transition:all 150ms cubic-bezier(0.4,0,0.2,1);font-family:var(--font-geist-sans,Geist),Arial,sans-serif;background:var(--primary);color:var(--primary-foreground);}.ds-button-primary:hover{background:color-mix(in oklch,var(--primary) 80%,transparent);}.ds-button-primary:focus-visible{border-color:var(--ring);outline:none;box-shadow:0 0 0 3px color-mix(in oklch,var(--ring) 50%,transparent);}.ds-button-primary:active{translate:0 1px;}.ds-button-primary:disabled{pointer-events:none;opacity:.5;}@media(prefers-reduced-motion:reduce){.ds-button-primary:active{translate:none;}}"
    },
