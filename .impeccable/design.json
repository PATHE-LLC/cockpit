      "css": ".ds-button-secondary{display:inline-flex;align-items:center;justify-content:center;gap:6px;height:36px;padding:0 12px;border:1px solid transparent;border-radius:var(--radius-4xl,1.625rem);font-size:14px;font-weight:500;line-height:20px;white-space:nowrap;cursor:pointer;transition:all 150ms cubic-bezier(0.4,0,0.2,1);font-family:var(--font-geist-sans,Geist),Arial,sans-serif;background:var(--secondary);color:var(--secondary-foreground);}.ds-button-secondary:hover{background:color-mix(in oklch,var(--secondary),var(--foreground) 5%);}.ds-button-secondary:focus-visible{border-color:var(--ring);outline:none;box-shadow:0 0 0 3px color-mix(in oklch,var(--ring) 50%,transparent);}.ds-button-secondary:active{translate:0 1px;}.ds-button-secondary:disabled{pointer-events:none;opacity:.5;}@media(prefers-reduced-motion:reduce){.ds-button-secondary:active{translate:none;}}"
