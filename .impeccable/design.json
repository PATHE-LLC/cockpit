      "description": "The shared default Tabs, shown with QA labels.",
      "html": "<div class=\"ds-tabs\" role=\"tablist\" aria-label=\"QA workspace\"><button type=\"button\" class=\"ds-tab\" role=\"tab\" aria-selected=\"true\">Checks</button><button type=\"button\" class=\"ds-tab\" role=\"tab\" aria-selected=\"false\">Results</button><button type=\"button\" class=\"ds-tab\" role=\"tab\" aria-selected=\"false\">Release</button></div>",
      "css": ".ds-tabs{display:inline-flex;align-items:center;justify-content:center;height:36px;padding:3px;border-radius:var(--radius-4xl,1.625rem);background:var(--muted);color:var(--muted-foreground);}.ds-tab{display:inline-flex;align-items:center;justify-content:center;height:calc(100% - 1px);padding:4px 8px;border:1px solid transparent;border-radius:var(--radius-xl,.875rem);background:transparent;color:color-mix(in oklch,var(--foreground) 60%,transparent);font-size:14px;font-weight:500;line-height:20px;white-space:nowrap;transition:all 150ms cubic-bezier(0.4,0,0.2,1);font-family:var(--font-geist-sans,Geist),Arial,sans-serif;}.ds-tab:hover{color:var(--foreground);}.ds-tab[aria-selected=true]{background:var(--background);color:var(--foreground);}.ds-tab:focus-visible{border-color:var(--ring);outline:none;box-shadow:0 0 0 3px color-mix(in oklch,var(--ring) 50%,transparent);}.ds-tab:disabled{pointer-events:none;opacity:.5;}:host-context(.dark) .ds-tab{color:var(--muted-foreground);}:host-context(.dark) .ds-tab[aria-selected=true]{border-color:var(--input);background:color-mix(in oklch,var(--input) 30%,transparent);color:var(--foreground);}"
